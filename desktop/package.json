{
  "name": "aither-notes",
  "version": "5.1.0",
  "description": "Aither Notes desktop app",
  "main": "main.js",
  "author": "OGAitherTech",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "tech.aither.notes",
    "productName": "Aither Notes",
    "artifactName": "Aither-Notes-${version}-${os}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "icon.svg", "../index.html", "../style.css", "../app.js", "../manifest.webmanifest", "../sw.js"],
    "asar": true,
    "compression": "maximum",
    "win": {"target": [{"target":"nsis","arch":["x64","arm64"]},{"target":"portable","arch":["x64","arm64"]}]},
    "nsis": {"oneClick": false,"allowToChangeInstallationDirectory": true,"createDesktopShortcut": true,"createStartMenuShortcut": true},
    "mac": {"target": [{"target":"dmg","arch":["x64","arm64"]}],"category":"public.app-category.productivity"},
    "linux": {"target": [{"target":"AppImage","arch":["x64"]},{"target":"deb","arch":["x64"]}],"category":"Office"}
  }
}
